#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${SUBI_SELLER_CONFIG_FILE:-$HOME/.subi/seller/config.env}"
EXPECTED="${SUBI_SELLER_DOCTOR_EXPECTED:-SUBI_SELLER_DOCTOR_OK}"
PROMPT="${SUBI_SELLER_DOCTOR_PROMPT:-Reply exactly: $EXPECTED}"

fail() {
  printf 'fail: %s\n' "$*" >&2
  exit 1
}

pass() {
  printf 'ok: %s\n' "$*"
}

mask_secret() {
  local value="$1"
  local len=${#value}
  if (( len <= 8 )); then
    printf '<set:%s chars>' "$len"
    return
  fi
  printf '%s...%s' "${value:0:4}" "${value: -4}"
}

[[ -f "$CONFIG_FILE" ]] || fail "seller config not found: $CONFIG_FILE"

set -a
source "$CONFIG_FILE"
set +a

[[ -n "${SUBI_GATEWAY_WS_URL:-}" ]] || fail "SUBI_GATEWAY_WS_URL is not set"
[[ -n "${SUBI_SELLER_NODE_TOKEN:-}" ]] || fail "SUBI_SELLER_NODE_TOKEN is not set"
[[ -n "${SUBI_NODE_ID:-}" ]] || fail "SUBI_NODE_ID is not set"
[[ -n "${SELLER_UPSTREAM_MODE:-}" ]] || fail "SELLER_UPSTREAM_MODE is not set"

pass "node_id=$SUBI_NODE_ID"
pass "gateway_ws=$SUBI_GATEWAY_WS_URL"
pass "node_token=$(mask_secret "$SUBI_SELLER_NODE_TOKEN")"
pass "upstream_mode=$SELLER_UPSTREAM_MODE"

[[ "${SELLER_UPSTREAM_MODE}" == "codex-login" ]] || fail "unsupported upstream mode: $SELLER_UPSTREAM_MODE"
[[ -n "${SELLER_CODEX_HOME:-${CODEX_HOME:-}}" ]] || fail "SELLER_CODEX_HOME or CODEX_HOME is not set"

pass "seller environment is ready"
